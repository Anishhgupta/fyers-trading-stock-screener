# Copy this file to .env and fill in real values. NEVER commit .env.
# Load it before running, e.g.:  export $(cat .env | xargs)   (Linux/Mac)
#                            or:  use `python-dotenv` / a launcher script on Windows

# --- Choose ONE broker and fill in only that section ---

# Fyers (v3 API)
# FYERS_CLIENT_ID / FYERS_SECRET_ID / FYERS_REDIRECT_URI come from your
# app at https://myapi.fyers.in/dashboard -> Create App.
# FYERS_ACCESS_TOKEN is generated DAILY by running fyers_login.py each
# trading morning -- Fyers tokens expire at end of day, unlike Angel
# One's TOTP which regenerates itself.
FYERS_CLIENT_ID=
FYERS_SECRET_ID=
FYERS_REDIRECT_URI=
FYERS_ACCESS_TOKEN=

# Angel One (SmartAPI)
ANGEL_API_KEY=
ANGEL_CLIENT_ID=
ANGEL_PASSWORD=
ANGEL_TOTP_SECRET=
